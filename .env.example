# Flutter E-commerce environment configuration
# Copy to .env and fill in real values

# Supabase (products, cart, orders, auth)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here

# API base URL for product catalog, orders, and authentication
API_BASE_URL=https://api.example.com

# API key for backend authentication (if applicable)
API_KEY=your_api_key_here

# Stripe publishable key for payment processing
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Sentry DSN for crash reporting (optional)
SENTRY_DSN=

# Environment: development | staging | production
APP_ENV=development
